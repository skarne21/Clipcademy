      "diagram": "proof",
      "title": "Proofreading: during copying",
      "narration": "DNA polymerase can proofread while copying DNA. If it adds a wrong base, its exonuclease activity removes the incorrect base from the three prime end, allowing the correct base to be added.",
      "stage": {
        "bottom": 3,
        "polymerase": true
      },
      "beats": [
        {
          "on": "^",
          "do": [
            "extend"
          ]
        },
        {
          "on": "proofread",
          "do": [
            "point:polymerase"
          ]
        },
        {
          "on": "wrong",
          "do": [
            "misadd",
            "pose:surprised",
            "pulse:damage"
          ]
        },
        {
          "on": "exonuclease",
          "do": [
            "zoom:damage"
          ]
        },
        {
          "on": "removes",
          "do": [
            "excise",
            "card:Wrong base removed from the growing 3′ end"
          ]
        },
