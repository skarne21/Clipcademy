            "pulse:three_end",
            "point:three_end"
          ]
        },
        {
          "on": "correct",
          "do": [
            "fix",
            "zoom_out",
            "pose:thumbs"
          ]
        }
      ]
    },
    {
      "diagram": "mismatch",
      "title": "Mismatch repair: after replication",
      "narration": "Mismatch repair happens after replication is complete. Proteins scan the new double helix for mismatched bases. Specialized enzymes remove the affected section and replace it with the correct DNA nucleotides.",
      "stage": {
        "bottom": 11,
        "wrong": 5
      },
      "beats": [
        {
          "on": "after",
