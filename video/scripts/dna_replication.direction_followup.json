  "scenes": [
    {
      "diagram": "strand",
      "title": "Which end does new DNA grow from?",
      "narration": "Let's fix this one. Find the two ends of the new strand. This end is 5-prime. This end is 3-prime. Now watch where new pieces go. Every single one joins the 3-prime end. Like a line where people only join at the back. The 5-prime end never changes. Adding at the 3-prime end means DNA grows 5-prime to 3-prime. Now try the question again.",
      "stage": {
        "strand": 3
      },
      "beats": [
        {
          "on": "^",
          "do": [
            "pose:present",
            "pulse:strand"
          ]
        },
        {
          "on": "find",
          "do": [
            "point:strand"
          ]
        },
        {
          "on": "5-prime",
          "do": [
            "label:5",
            "pulse:new_5",
            "point:new_5"
          ]
        },
        {
          "on": "3-prime",
          "do": [
            "label:3",
            "pulse:new_3",
            "point:new_3"
          ]
        },
        {
          "on": "watch",
          "do": [
            "zoom:new_3",
            "extend"
          ]
        },
        {
          "on": "every",
          "do": [
            "pulse:new_3"
          ]
        },
        {
          "on": "line",
          "do": [
            "pose:present"
          ]
        },
        {
          "on": "never",
          "do": [
            "zoom_out",
            "pulse:new_5",
            "point:new_5"
          ]
        },
        {
          "on": "adding",
          "do": [
            "arrow"
          ]
        },
        {
          "on": "means",
          "do": [
            "card:Grows 5′ → 3′"
          ]
        },
        {
          "on": "again",
          "do": [
            "pose:thumbs"
          ]
        }
      ]
    }
  ]
