    {
      "diagram": "uv",
      "title": "UV can distort DNA",
      "narration": "UV light can cause adjacent cytosines and thymines to form covalent bonds. The resulting distortion in the DNA backbone interferes with normal copying and transcription. This is damage that must be recognized and removed.",
      "stage": {
        "bottom": 11
      },
      "beats": [
        {
          "on": "uv",
          "do": [
            "uv",
            "point:damage"
          ]
        },
        {
          "on": "covalent",
          "do": [
            "bond",
            "pulse:damage"
          ]
        },
        {
          "on": "distortion",
          "do": [
            "distort",
            "zoom:damage"
          ]
        },
        {
          "on": "interferes",
          "do": [
            "pose:surprised"
          ]
        },
        {
          "on": "this",
          "do": [
            "zoom_out",
            "card:UV: adjacent bases bond and distort DNA"
          ]
        },
        {
          "on": "recognized",
          "do": [
            "point:damage",
            "pulse:damage"
          ]
        }
      ]
    },
    {
      "diagram": "cut",
      "title": "Recognize and cut out",
      "narration": "Repair proteins recognize the damaged site. Enzymes cut the backbone on either side of the problem and remove the damaged section from that strand. The diagram shows the gap left by that removal.",
      "stage": {
        "bottom": 11,
        "damaged": true
      },
      "beats": [
        {
          "on": "repair",
          "do": [
            "recognize",
            "point:protein"
          ]
        },
        {
          "on": "cut",
          "do": [
            "cut",
            "pulse:cuts"
          ]
        },
        {
          "on": "remove",
          "do": [
            "remove"
          ]
        },
        {
          "on": "gap",
          "do": [
            "pulse:gap",
            "point:gap",
            "card:Damaged section removed from one strand"
          ]
        }
      ]
    },
    {
      "diagram": "reseal",
      "title": "Replace and reseal",
      "narration": "The missing section is replaced with correct DNA nucleotides. The backbone is then resealed by forming phosphodiester linkages. Remember the sequence: recognize the damage, cut out the section, replace it, and reseal the backbone.",
