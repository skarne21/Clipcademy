# Postgres (matches docker-compose defaults)
DATABASE_URL="postgresql://clipcademy:clipcademy@localhost:5433/clipcademy?schema=public"

# Server-side only (catalog scripts; never expose to the client)
YOUTUBE_API_KEY=

# LLM (server-side only)
# LLM_PROVIDER=openai
# LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_GENERATION_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000

# Phase 3: false = normal validated generation; true = dev-only, skips validator
DEV_SKIP_VALIDATION=false
GENERATION_MAX_RETRIES=2
SANDBOX_DOCKER_IMAGE=clipcademy-python-sandbox
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_STARTUP_TIMEOUT_MS=15000
SANDBOX_DOCKER_GRACE_MS=3000
# SANDBOX_LOG_TIMINGS=true

# Phase 4+
# DAILY_GENERATION_LIMIT_PER_USER=20
